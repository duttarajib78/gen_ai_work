# Local development only (SageMaker Code Editor terminal or laptop). NEVER put credentials in this file:
# authenticate with `aws sso login --profile <profile>` or the Studio execution role.
AWS_PROFILE=<your-sso-profile>
AWS_REGION=<your-bedrock-region>

RULE_EXTRACTOR_ENV=dev
RULE_EXTRACTOR_BACKEND=local
# Inference profile geography: au (default, keeps inference in Australia) | apac | us | eu | global
RULE_EXTRACTOR_BEDROCK_PROFILE_PREFIX=au
RULE_EXTRACTOR_MODEL_STRONG=anthropic.claude-sonnet-5
RULE_EXTRACTOR_MODEL_FAST=anthropic.claude-haiku-4-5-20251001-v1:0
RULE_EXTRACTOR_CONCURRENCY=3

# Paths for local runs
RULE_EXTRACTOR_SOURCE_DOCS_DIR=./source_docs
RULE_EXTRACTOR_CORPUS_DIR=./corpus
RULE_EXTRACTOR_OUTPUT_DIR=./sample_output
RULE_EXTRACTOR_STATE_DIR=./checkpoints
RULE_EXTRACTOR_CONFIG_FILE=./configs/base.yaml
