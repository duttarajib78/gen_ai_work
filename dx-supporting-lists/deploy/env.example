# Non-secret configuration for local runs: `set -a; source deploy/env.example; set +a`.
# THERE ARE NO CREDENTIALS HERE AND THERE MUST NEVER BE: models and storage are reached with your AWS identity locally (aws sso login / a profile)
# and with the endpoint's IAM role in production. See README, "Configuration reference", for every variable.
DX_ENV=development
DX_AWS_REGION=ap-southeast-2
DX_MODEL=claude-sonnet-5
DX_INFERENCE_PROFILE_PREFIX=au
DX_THINKING=low
DX_LLM_CONCURRENCY=16
DX_DATA_DIR=./data
DX_STORE_URI=./output
